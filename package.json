{
  "name": "iscor-resume",
  "version": "2.0.0",
  "description": "Full resume",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch-path=src scripts/dev.ts",
    "build": "node scripts/build.ts",
    "build:pdf": "node scripts/pdf.ts",
    "build:all": "npm run clean && npm run build && npm run build:pdf",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iGitScor/resume.git"
  },
  "keywords": [
    "resume",
    "template",
    "generator"
  ],
  "author": "iGitScor <sebastien.correaud@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iGitScor/resume/issues"
  },
  "homepage": "https://cv.iscor.me",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jsonresume/schema": "^1.3.1",
    "@types/node": "^24.19.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
